# ==============================================================================
# ResearchGraph Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development setup.
# DO NOT commit real secrets, passwords, or production credentials to Git.
# ==============================================================================

# --- Application Environment ---
RESEARCHGRAPH_APP_NAME="ResearchGraph Scientific Discovery Backend"
RESEARCHGRAPH_APP_VERSION="1.0.0"
RESEARCHGRAPH_ENV="development"
RESEARCHGRAPH_DEBUG=true
RESEARCHGRAPH_LOG_LEVEL="INFO"
RESEARCHGRAPH_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# --- Backend Server & CORS ---
RESEARCHGRAPH_HOST="0.0.0.0"
RESEARCHGRAPH_PORT=8000
RESEARCHGRAPH_API_PREFIX="/api/v1"
RESEARCHGRAPH_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# --- Scientific Storage & Artifact Paths ---
RESEARCHGRAPH_SQLITE_PATH="./dataset/processed/v0.5.1/knowledge_base.db"
RESEARCHGRAPH_CHUNKS_PATH="./dataset/processed/v0.2.0/chunks.parquet"
RESEARCHGRAPH_PAPERS_CATALOG_PATH="./dataset/raw/v0.1.0/papers.jsonl"
RESEARCHGRAPH_EMBEDDINGS_RELEASE_PATH="./dataset/processed/v0.6.0"

# --- Semantic Retrieval & Embedding Configuration ---
# Supported models:
# - tfidf-lsa-384: Deterministic, CPU-friendly LSA baseline (No PyTorch/HuggingFace download required)
# - all-MiniLM-L6-v2: General sentence embeddings (384d, sentence-transformers)
# - bge-small-en-v1.5: Retrieval-optimized embeddings (384d, BAAI)
# - scibert-scivocab-uncased: Scientific domain embeddings (768d, AllenAI)
RESEARCHGRAPH_EMBEDDING_MODEL_KEY="tfidf-lsa-384"
RESEARCHGRAPH_DEFAULT_TOP_K=5

# --- Optional Scholarly Literature APIs (Rate-limited, audited) ---
OPENALEX_MAILTO=""
OPENALEX_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""
ARXIV_USER_AGENT="ResearchGraph/1.0.0 (mailto:developer@example.org)"

# --- Optional LLM Synthesis Providers (Reviewer #2, Hypothesis Generation) ---
# Deterministic local heuristic models are used by default when API keys are absent.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
