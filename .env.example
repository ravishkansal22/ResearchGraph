# ==============================================================================
# ResearchGraph Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your local development setup.
# DO NOT commit real secrets, passwords, or production credentials to Git.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# --- Backend Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=researchgraph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchgraph

# --- Cache & Message Broker (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Scholarly Literature APIs (Phase 1: Ingestion) ---
# OpenAlex (Polite Pool requires email in user agent or query)
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Semantic Scholar API Key (Optional for higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# arXiv API / User Agent
ARXIV_USER_AGENT=ResearchGraph/0.1.0

# --- LLM & Embedding Providers (Placeholders for Future Exploration) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Paths & Storage ---
DATASET_STORAGE_ROOT=./dataset
ARTIFACTS_DIR=./artifacts
