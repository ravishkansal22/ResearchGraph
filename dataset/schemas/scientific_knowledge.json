{
  "scientific_entity": {
    "$defs": {
      "AttributionType": {
        "description": "Epistemological attribution of the extracted knowledge.",
        "enum": [
          "AUTHOR_STATED",
          "SYSTEM_INFERRED"
        ],
        "title": "AttributionType",
        "type": "string"
      },
      "EvidenceSpan": {
        "description": "Cryptographic and character-level evidence span linking extraction to source text.",
        "properties": {
          "text": {
            "description": "Exact textual evidence quotation extracted from chunk",
            "title": "Text",
            "type": "string"
          },
          "start_char": {
            "description": "0-indexed start character offset in chunk text",
            "minimum": 0,
            "title": "Start Char",
            "type": "integer"
          },
          "end_char": {
            "description": "0-indexed end character offset in chunk text",
            "exclusiveMinimum": 0,
            "title": "End Char",
            "type": "integer"
          },
          "is_exact_match": {
            "default": true,
            "description": "True if text matches chunk[start_char:end_char] exactly",
            "title": "Is Exact Match",
            "type": "boolean"
          },
          "confidence": {
            "default": 1.0,
            "description": "Confidence in evidence boundary alignment",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          }
        },
        "required": [
          "text",
          "start_char",
          "end_char"
        ],
        "title": "EvidenceSpan",
        "type": "object"
      },
      "ExtractionProvenance": {
        "description": "Complete document, section, and chunk provenance for reproducibility.",
        "properties": {
          "canonical_id": {
            "description": "Canonical paper identifier (e.g. rg_doi_xxx)",
            "title": "Canonical Id",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Document processing identifier",
            "title": "Document Id"
          },
          "chunk_id": {
            "description": "Source chunk identifier (e.g. chk_rg_xxx_A_001)",
            "title": "Chunk Id",
            "type": "string"
          },
          "section_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Containing section identifier",
            "title": "Section Id"
          },
          "section_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Containing section heading",
            "title": "Section Title"
          },
          "section_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 1,
            "description": "Section hierarchy level",
            "title": "Section Level"
          },
          "page_start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Starting physical page number",
            "title": "Page Start"
          },
          "page_end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Ending physical page number",
            "title": "Page End"
          },
          "file_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "SHA-256 hash of source PDF",
            "title": "File Hash"
          }
        },
        "required": [
          "canonical_id",
          "chunk_id"
        ],
        "title": "ExtractionProvenance",
        "type": "object"
      },
      "ScientificEntityType": {
        "description": "Scientific entity and concept categories.",
        "enum": [
          "METHOD",
          "PROBLEM",
          "BOTTLENECK",
          "METRIC",
          "DATASET",
          "TASK",
          "ASSUMPTION",
          "DOMAIN"
        ],
        "title": "ScientificEntityType",
        "type": "string"
      },
      "ValidationStatus": {
        "description": "Quality and evidence grounding verification status.",
        "enum": [
          "VALIDATED",
          "NEEDS_REVIEW",
          "REJECTED"
        ],
        "title": "ValidationStatus",
        "type": "string"
      }
    },
    "description": "Typed scientific entity or concept record.",
    "properties": {
      "record_id": {
        "description": "Stable unique record ID (e.g. ent_rg_xxx_001)",
        "title": "Record Id",
        "type": "string"
      },
      "schema_version": {
        "default": "0.4.0",
        "description": "Schema definition version",
        "title": "Schema Version",
        "type": "string"
      },
      "category": {
        "$ref": "#/$defs/ScientificEntityType",
        "description": "Scientific entity category"
      },
      "surface_text": {
        "description": "Original surface text as it appeared in source chunk",
        "title": "Surface Text",
        "type": "string"
      },
      "normalized_name": {
        "description": "Conservative normalized entity name",
        "title": "Normalized Name",
        "type": "string"
      },
      "evidence": {
        "$ref": "#/$defs/EvidenceSpan",
        "description": "Character-level supporting evidence span"
      },
      "provenance": {
        "$ref": "#/$defs/ExtractionProvenance",
        "description": "Full source provenance"
      },
      "attribution": {
        "$ref": "#/$defs/AttributionType",
        "default": "AUTHOR_STATED",
        "description": "Attribution origin"
      },
      "confidence_score": {
        "default": 1.0,
        "description": "Extraction confidence score",
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Confidence Score",
        "type": "number"
      },
      "extraction_method": {
        "default": "rule_based_v1",
        "description": "Identifier of extractor algorithm/model",
        "title": "Extraction Method",
        "type": "string"
      },
      "extraction_version": {
        "default": "v0.4.0",
        "description": "Pipeline execution version",
        "title": "Extraction Version",
        "type": "string"
      },
      "validation_status": {
        "$ref": "#/$defs/ValidationStatus",
        "default": "VALIDATED",
        "description": "Grounding status"
      },
      "validation_notes": {
        "description": "Diagnostic notes or validation warnings",
        "items": {
          "type": "string"
        },
        "title": "Validation Notes",
        "type": "array"
      },
      "related_record_ids": {
        "description": "Linked record IDs in knowledge graph",
        "items": {
          "type": "string"
        },
        "title": "Related Record Ids",
        "type": "array"
      }
    },
    "required": [
      "record_id",
      "category",
      "surface_text",
      "normalized_name",
      "evidence",
      "provenance"
    ],
    "title": "ScientificEntityRecord",
    "type": "object"
  },
