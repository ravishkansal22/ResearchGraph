{
  "$defs": {
    "AliasMapping": {
      "description": "Explicit mapping between a surface variation and its canonical entity name.",
      "properties": {
        "surface_form": {
          "description": "Normalized surface variant (e.g. 'cnn')",
          "title": "Surface Form",
          "type": "string"
        },
        "canonical_name": {
          "description": "Canonical representative name (e.g. 'convolutional neural network')",
          "title": "Canonical Name",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ScientificEntityType",
          "description": "Associated scientific entity category"
        },
        "status": {
          "$ref": "#/$defs/AliasResolutionStatus",
          "default": "CONFIRMED",
          "description": "Resolution status"
        },
        "rationale": {
          "default": "Acronym / Full name expansion",
          "description": "Scholarly or linguistic rationale",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "surface_form",
        "canonical_name",
        "category"
      ],
      "title": "AliasMapping",
      "type": "object"
    },
    "AliasResolutionStatus": {
      "description": "Resolution status of concept aliases and lexical variants.",
      "enum": [
        "CONFIRMED",
        "CANDIDATE",
        "UNRESOLVED",
        "SEPARATE"
      ],
      "title": "AliasResolutionStatus",
      "type": "string"
    },
    "AttributionType": {
      "description": "Epistemological attribution of the extracted knowledge.",
      "enum": [
        "AUTHOR_STATED",
        "SYSTEM_INFERRED"
      ],
      "title": "AttributionType",
      "type": "string"
    },
    "Author": {
      "description": "Normalized author representation.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Name"
        },
        "orcid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        },
        "affiliations": {
          "items": {
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "CanonicalEntityNode": {
      "description": "Consolidated, canonical scientific concept or entity in the knowledge base.",
      "properties": {
        "entity_id": {
          "description": "Stable deterministic entity ID (e.g. kb_ent_method_xxx)",
          "title": "Entity Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.5.0",
          "description": "Schema definition version",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ScientificEntityType",
          "description": "Scientific entity category"
        },
        "canonical_name": {
          "description": "Normalized canonical concept label",
          "title": "Canonical Name",
          "type": "string"
        },
        "aliases": {
          "description": "Confirmed synonym and surface variants",
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "mentions_count": {
          "default": 1,
          "description": "Total occurrences across the corpus",
          "title": "Mentions Count",
          "type": "integer"
        },
        "paper_ids": {
          "description": "List of papers where entity is mentioned",
          "items": {
            "type": "string"
          },
          "title": "Paper Ids",
          "type": "array"
        },
        "chunk_ids": {
          "description": "List of chunks containing mentions",
          "items": {
            "type": "string"
          },
          "title": "Chunk Ids",
          "type": "array"
        },
        "mention_ids": {
          "description": "Foreign keys to individual EntityMentions",
          "items": {
            "type": "string"
          },
          "title": "Mention Ids",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grounded concept definition or description",
          "title": "Description"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "VALIDATED",
          "description": "Validation status"
        },
        "alias_resolution_status": {
          "$ref": "#/$defs/AliasResolutionStatus",
          "default": "CONFIRMED",
          "description": "Confidence of alias consolidation"
        },
        "first_seen_version": {
          "default": "v0.4.0",
          "description": "Earliest pipeline version where entity appeared",
          "title": "First Seen Version",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "category",
        "canonical_name"
      ],
      "title": "CanonicalEntityNode",
      "type": "object"
    },
    "CanonicalPaperNode": {
      "description": "Canonical representation of a scientific paper within the knowledge base.",
      "properties": {
        "paper_id": {
          "description": "Stable canonical paper identifier (e.g. rg_doi_xxx)",
          "title": "Paper Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.5.0",
          "description": "Schema definition version",
          "title": "Schema Version",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized DOI string",
          "title": "Doi"
        },
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Normalized arXiv identifier",
          "title": "Arxiv Id"
        },
        "title": {
          "description": "Normalized paper title",
          "title": "Title",
          "type": "string"
        },
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full abstract text",
          "title": "Abstract"
        },
        "publication_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year of publication",
          "title": "Publication Year"
        },
        "venue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Venue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication venue details"
        },
        "authors": {
          "description": "Ordered list of authors",
          "items": {
            "$ref": "#/$defs/Author"
          },
          "title": "Authors",
          "type": "array"
        },
        "topics": {
          "description": "Domain and concept topics",
          "items": {
            "$ref": "#/$defs/Topic"
          },
          "title": "Topics",
          "type": "array"
        },
        "open_access_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct URL to open-access paper",
          "title": "Open Access Url"
        },
        "file_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 hash of source PDF artifact",
          "title": "File Hash"
        },
        "total_entities_count": {
          "default": 0,
          "description": "Count of extracted entities linked to paper",
          "title": "Total Entities Count",
          "type": "integer"
        },
        "total_statements_count": {
          "default": 0,
          "description": "Count of statements linked to paper",
          "title": "Total Statements Count",
          "type": "integer"
        },
        "total_relationships_count": {
          "default": 0,
          "description": "Count of relations linked to paper",
          "title": "Total Relationships Count",
          "type": "integer"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "title"
      ],
      "title": "CanonicalPaperNode",
      "type": "object"
    },
    "CanonicalRelationshipNode": {
      "description": "Verified semantic relationship between canonical entities or statements.",
      "properties": {
        "relationship_id": {
          "description": "Stable unique relationship ID (e.g. kb_rel_xxx)",
          "title": "Relationship Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.5.1",
          "description": "Schema definition version",
          "title": "Schema Version",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/ScientificRelationType",
          "description": "Semantic relation predicate"
        },
        "source_id": {
          "description": "Foreign key to subject node (entity or statement)",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "description": "Foreign key to object node (entity or statement)",
          "title": "Target Id",
          "type": "string"
        },
        "source_type": {
          "default": "ENTITY",
          "description": "'ENTITY' or 'STATEMENT'",
          "title": "Source Type",
          "type": "string"
        },
        "target_type": {
          "default": "ENTITY",
          "description": "'ENTITY' or 'STATEMENT'",
          "title": "Target Type",
          "type": "string"
        },
        "paper_id": {
          "description": "Foreign key to CanonicalPaperNode",
          "title": "Paper Id",
          "type": "string"
        },
        "chunk_id": {
          "description": "Source chunk identifier",
          "title": "Chunk Id",
          "type": "string"
        },
        "surface_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connecting phrase or trigger span in text",
          "title": "Surface Text"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan",
          "description": "Supporting evidence span for relation"
        },
        "provenance": {
          "$ref": "#/$defs/ExtractionProvenance",
          "description": "Full source provenance"
        },
        "attribution": {
          "$ref": "#/$defs/AttributionType",
          "default": "AUTHOR_STATED",
          "description": "Attribution origin"
        },
        "is_directed": {
          "default": true,
          "description": "True if relationship is directed",
          "title": "Is Directed",
          "type": "boolean"
        },
        "confidence_score": {
          "default": 1.0,
          "description": "Extraction confidence score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "extraction_version": {
          "default": "v0.4.1",
          "description": "Originating pipeline version",
          "title": "Extraction Version",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "VALIDATED",
          "description": "Grounding status (historical compatibility)"
        },
        "structural_validity": {
          "$ref": "#/$defs/StructuralValidityStatus",
          "default": "STRUCTURALLY_VALID",
          "description": "Schema and endpoint referential integrity status"
        },
        "evidence_support": {
          "$ref": "#/$defs/EvidenceSupportStatus",
          "default": "NOT_ASSESSED",
          "description": "Scientific entailment status of relationship given evidence"
        },
        "human_verification": {
          "$ref": "#/$defs/HumanVerificationStatus",
          "default": "PENDING",
          "description": "Qualified human review status"
        },
        "correction_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diagnostic reason or correction rationale",
          "title": "Correction Notes"
        },
        "upstream_relation_id": {
          "description": "Relation ID from upstream extraction stage",
          "title": "Upstream Relation Id",
          "type": "string"
        }
      },
      "required": [
        "relationship_id",
        "relation_type",
        "source_id",
        "target_id",
        "paper_id",
        "chunk_id",
        "evidence",
        "provenance",
        "upstream_relation_id"
      ],
      "title": "CanonicalRelationshipNode",
      "type": "object"
    },
    "CanonicalStatementNode": {
      "description": "Grounded scientific proposition, claim, result, limitation, or future direction.",
      "properties": {
        "statement_id": {
          "description": "Stable unique statement ID (e.g. kb_stmt_xxx)",
          "title": "Statement Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.5.0",
          "description": "Schema definition version",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ScientificStatementType",
          "description": "Statement category"
        },
        "surface_text": {
          "description": "Verbatim original sentence or clause",
          "title": "Surface Text",
          "type": "string"
        },
        "normalized_statement": {
          "description": "Normalized statement representation",
          "title": "Normalized Statement",
          "type": "string"
        },
        "paper_id": {
          "description": "Foreign key to CanonicalPaperNode",
          "title": "Paper Id",
          "type": "string"
        },
        "chunk_id": {
          "description": "Source chunk identifier",
          "title": "Chunk Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan",
          "description": "Character-level supporting evidence span"
        },
        "provenance": {
          "$ref": "#/$defs/ExtractionProvenance",
          "description": "Full source provenance"
        },
        "attribution": {
          "$ref": "#/$defs/AttributionType",
          "default": "AUTHOR_STATED",
          "description": "Attribution origin"
        },
        "confidence_score": {
          "default": 1.0,
          "description": "Extraction confidence",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "extraction_version": {
          "default": "v0.4.1",
          "description": "Originating pipeline version",
          "title": "Extraction Version",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "VALIDATED",
          "description": "Grounding status"
        },
        "validation_notes": {
          "description": "Validation notes or warnings",
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        },
        "related_entity_ids": {
          "description": "Linked CanonicalEntityNode IDs",
          "items": {
            "type": "string"
          },
          "title": "Related Entity Ids",
          "type": "array"
        },
        "upstream_record_id": {
          "description": "Record ID from upstream extraction stage",
          "title": "Upstream Record Id",
          "type": "string"
        }
      },
      "required": [
        "statement_id",
        "category",
        "surface_text",
        "normalized_statement",
        "paper_id",
        "chunk_id",
        "evidence",
        "provenance",
        "upstream_record_id"
      ],
      "title": "CanonicalStatementNode",
      "type": "object"
    },
    "EntityMention": {
      "description": "Individual textual occurrence of a scientific entity grounded in a specific chunk.",
      "properties": {
        "mention_id": {
          "description": "Stable unique mention ID (e.g. ent_men_xxx)",
          "title": "Mention Id",
          "type": "string"
        },
        "entity_id": {
          "description": "Foreign key to CanonicalEntityNode",
          "title": "Entity Id",
          "type": "string"
        },
        "paper_id": {
          "description": "Foreign key to CanonicalPaperNode",
          "title": "Paper Id",
          "type": "string"
        },
        "chunk_id": {
          "description": "Source chunk identifier",
          "title": "Chunk Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ScientificEntityType",
          "description": "Scientific entity category"
        },
        "surface_text": {
          "description": "Exact original surface text as appeared in chunk",
          "title": "Surface Text",
          "type": "string"
        },
        "normalized_name": {
          "description": "Conservative normalized form of mention",
          "title": "Normalized Name",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan",
          "description": "Character-level supporting evidence span"
        },
        "provenance": {
          "$ref": "#/$defs/ExtractionProvenance",
          "description": "Complete extraction provenance"
        },
        "attribution": {
          "$ref": "#/$defs/AttributionType",
          "default": "AUTHOR_STATED",
          "description": "Attribution origin"
        },
        "confidence_score": {
          "default": 1.0,
          "description": "Extraction confidence",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "extraction_version": {
          "default": "v0.4.1",
          "description": "Originating pipeline version",
          "title": "Extraction Version",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ValidationStatus",
          "default": "VALIDATED",
          "description": "Grounding status"
        },
        "upstream_record_id": {
          "description": "Record ID from upstream extraction stage",
          "title": "Upstream Record Id",
          "type": "string"
        }
      },
      "required": [
        "mention_id",
        "entity_id",
        "paper_id",
        "chunk_id",
        "category",
        "surface_text",
        "normalized_name",
        "evidence",
        "provenance",
        "upstream_record_id"
      ],
      "title": "EntityMention",
      "type": "object"
    },
    "EvidenceSpan": {
      "description": "Cryptographic and character-level evidence span linking extraction to source text.",
      "properties": {
        "text": {
          "description": "Exact textual evidence quotation extracted from chunk",
          "title": "Text",
          "type": "string"
        },
        "start_char": {
          "description": "0-indexed start character offset in chunk text",
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "description": "0-indexed end character offset in chunk text",
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "is_exact_match": {
          "default": true,
          "description": "True if text matches chunk[start_char:end_char] exactly",
          "title": "Is Exact Match",
          "type": "boolean"
        },
        "confidence": {
          "default": 1.0,
          "description": "Confidence in evidence boundary alignment",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "text",
        "start_char",
        "end_char"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "description": "Scientific evidence entailment status for propositions and relationships.",
      "enum": [
        "NOT_ASSESSED",
        "SUPPORTED",
        "UNSUPPORTED",
        "AMBIGUOUS"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "ExtractionProvenance": {
      "description": "Complete document, section, and chunk provenance for reproducibility.",
      "properties": {
        "canonical_id": {
          "description": "Canonical paper identifier (e.g. rg_doi_xxx)",
          "title": "Canonical Id",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document processing identifier",
          "title": "Document Id"
        },
        "chunk_id": {
          "description": "Source chunk identifier (e.g. chk_rg_xxx_A_001)",
          "title": "Chunk Id",
          "type": "string"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Containing section identifier",
          "title": "Section Id"
        },
        "section_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Containing section heading",
          "title": "Section Title"
        },
        "section_level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1,
          "description": "Section hierarchy level",
          "title": "Section Level"
        },
        "page_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Starting physical page number",
          "title": "Page Start"
        },
        "page_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ending physical page number",
          "title": "Page End"
        },
        "file_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 hash of source PDF",
          "title": "File Hash"
        }
      },
      "required": [
        "canonical_id",
        "chunk_id"
      ],
      "title": "ExtractionProvenance",
      "type": "object"
    },
    "HumanVerificationStatus": {
      "description": "Independent qualified human expert verification status.",
      "enum": [
        "PENDING",
        "VERIFIED",
        "REJECTED",
        "NEEDS_ADJUDICATION"
      ],
      "title": "HumanVerificationStatus",
      "type": "string"
    },
    "KnowledgeBaseManifest": {
      "description": "Comprehensive, reproducible build manifest for the Scientific Knowledge Base.",
      "properties": {
        "kb_version": {
          "default": "v0.5.1",
          "description": "Knowledge base release version",
          "title": "Kb Version",
          "type": "string"
        },
        "schema_version": {
          "default": "0.5.1",
          "description": "Schema version",
          "title": "Schema Version",
          "type": "string"
        },
        "build_timestamp": {
          "title": "Build Timestamp",
          "type": "string"
        },
        "upstream_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Paths and versions of upstream inputs",
          "title": "Upstream Sources",
          "type": "object"
        },
        "total_papers_count": {
          "default": 0,
          "description": "Total canonical papers ingested",
          "title": "Total Papers Count",
          "type": "integer"
        },
        "total_canonical_entities_count": {
          "default": 0,
          "description": "Total unique canonical entities",
          "title": "Total Canonical Entities Count",
          "type": "integer"
        },
        "total_entity_mentions_count": {
          "default": 0,
          "description": "Total individual entity mentions grounded",
          "title": "Total Entity Mentions Count",
          "type": "integer"
        },
        "total_statements_count": {
